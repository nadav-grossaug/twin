.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
build/
# endpoint-DLP sidecar files
*:sec.endpointdlp
.claude/worktrees/
# GeoLife (zones: inside / transfer / outside / eval). Real data, caches and regenerable outputs are not committed;
# copy them by hand when moving machines (see geolife/inside/data/README.md and CHECKPOINTS.md).
geolife/inside/data/*
!geolife/inside/data/README.md
geolife/inside/results/
geolife/outside/cache/
geolife/outside/synthetic/*
!geolife/outside/synthetic/README.md
geolife/outside/synthetic_grid_dev/
geolife/outside/synthetic_grid_held/
geolife/eval/results/*.parquet
geolife/eval/results/*.pkl
# artifacts: commit seed 0 only (the rest is regenerated by stage 1)
# graph-AIM pipeline outputs: commit seed 0 only; the rest is regenerated by the three stages
snap/transfer/artifacts/*_seed[1-9]/
snap/outside/synthetic/*
!snap/outside/synthetic/graph_aim_eps4_seed0.npz
!snap/outside/synthetic/graph_aim_nocap_nonprivate_seed0.npz
!snap/outside/synthetic/index.json

# datasets (raw and processed); keep per-dataset README notes
*/data/*
*/*/data/*
!*/data/README.md
!*/*/data/README.md

# v1.1 outputs (attribute-coupling round): same conventions as the v1 dirs above
snap/transfer/artifacts_v1_1/*_seed[1-9]/
snap/outside/synthetic_v1_1/*
!snap/outside/synthetic_v1_1/graph_aim_eps4_seed0.npz
!snap/outside/synthetic_v1_1/graph_aim_nocap_nonprivate_seed0.npz
!snap/outside/synthetic_v1_1/index.json
# sweep / experiment scratch under tools/ (scripts and small digests are committed)
tools/before_graphs/
tools/sweep/*/
tools/sweep_d/*/
tools/exp_e/*
!tools/exp_e/*.py
# composition round (v2): commit seed 0 only, like the other rounds; tools/v2_runs keeps csv/py/md only
snap/transfer/artifacts_v2/*_seed[1-9]/
snap/outside/synthetic_v2/*
!snap/outside/synthetic_v2/graph_aim_eps4_seed0.npz
!snap/outside/synthetic_v2/graph_aim_nocap_nonprivate_seed0.npz
!snap/outside/synthetic_v2/index.json
tools/v2_runs/**/synthetic/
tools/v2_runs/final/
tools/v2_runs/*/*.log
tools/v2_runs/c_only*/results/
tools/v2_runs/e_nomargin/
# graph-aim-walks (NOT private, docs/snap/walks-plan.md): commit seed 0 only, like the other rounds
snap/transfer/artifacts_walks/*_seed[1-9]/
